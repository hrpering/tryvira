{
  "mcpServers": {
    "vira": {
      "command": "npx",
      "args": [
        "-y",
        "@tryvira/mcp@0.1.78"
      ],
      "env": {
        "VIRA_API_URL": "<your-vira-api-root>",
        "VIRA_API_KEY": "<server-held-api-key>",
        "VIRA_ORGANIZATION_ID": "<organization>",
        "VIRA_PROJECT_ID": "<project>",
        "VIRA_ENVIRONMENT_ID": "<environment>"
      }
    }
  }
}
