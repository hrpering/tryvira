{
  "schemaVersion": 1,
  "strategyKey": "marketing.launch_plan",
  "behaviorPointKey": "marketing.launch_plan",
  "executionMode": "STAGED",
  "resultMode": "behavior_plan",
  "goal": {
    "type": "produce",
    "artifact": "behavior-plan",
    "successCriteria": [
      "Preserve explicit or confirmed launch constraints and preferences",
      "Require full-funnel coverage and measurement in the downstream answer",
      "Separate facts, assumptions, hypotheses, and unknowns",
      "Do not draft the final user-visible launch plan"
    ]
  },
  "entryStepKey": "plan",
  "steps": [
    {
      "stableKey": "plan",
      "type": "model",
      "purpose": "Produce a compact behavior plan for the downstream chatbot: intent, explicit constraints, confirmed preferences, at most two labeled assumptions, response shape, measurement checks, safety boundaries, and a verification checklist. Never draft the final answer.",
      "requires": ["context:request"],
      "produces": ["state:behaviorPlan"],
      "outputSchemaRef": "schema:behavior-plan"
    },
    {
      "stableKey": "verify",
      "type": "verify",
      "purpose": "Verify the behavior plan is compact, request-specific, preference-safe, full-funnel aware, measurement-aware, and contains no full drafted answer.",
      "requires": ["state:behaviorPlan"],
      "produces": ["state:verified"],
      "verifierKeys": ["marketing.full_funnel", "marketing.measurement"]
    }
  ],
  "edges": [
    {"stableKey": "plan-to-verify", "from": "plan", "to": "verify"}
  ],
  "stateSlots": [
    {"key": "state:behaviorPlan", "schemaRef": "schema:behavior-plan", "privacy": "tenant", "source": "model", "maxBytes": 12000},
    {"key": "state:verified", "schemaRef": "schema:boolean", "privacy": "tenant", "source": "derived", "maxBytes": 100}
  ],
  "contextPolicy": {"allowedRefs": ["context:request"], "maxBytes": 100000},
  "evidencePolicy": {"requiredRefs": [], "allowMissing": true},
  "toolPolicy": {"allowedToolKeys": [], "effectfulToolKeys": []},
  "generationPolicy": {"structuredOnly": true},
  "verificationPolicy": {"requiredVerifierKeys": ["marketing.full_funnel", "marketing.measurement"], "requireFinalComposeVerification": false},
  "recoveryPolicy": {"maxTotalRecoveries": 1, "defaultAction": "block"},
  "budgets": {"maxStepExecutions": 5, "maxModelCalls": 1, "maxToolCalls": 0, "maxDecisionCalls": 0, "maxRepairAttempts": 1, "maxSerializedStateBytes": 50000}
}
