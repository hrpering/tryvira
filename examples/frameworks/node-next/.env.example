# OFF baseline calls the configured provider. Keep all secrets server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ON sends the prompt to a server-owned AUTO TaskRun, not to behavior-projection.
# This public sample does not claim verified final-provider answer retrieval.
VIRA_API_URL=
VIRA_API_KEY=
VIRA_ORGANIZATION_ID=
VIRA_PROJECT_ID=
VIRA_ENVIRONMENT_ID=
# A real, scoped connection with server-attested host capabilities where required.
VIRA_CONNECTION_ID=
VIRA_AI_SYSTEM_ID=

# For explicitly authorized non-production connection creation only:
VIRA_TUTORIAL_NON_PRODUCTION=false
VIRA_ALLOW_CONNECT=false
VIRA_CONNECT_IDEMPOTENCY_KEY=
VIRA_SYSTEM_NAME=support-chatbot-example
