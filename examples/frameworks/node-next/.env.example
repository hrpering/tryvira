# The OFF chatbot needs only the model key. Keep all keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set these only when Vira has provisioned access for your organization.
VIRA_API_URL=
VIRA_API_KEY=
VIRA_ORGANIZATION_ID=
VIRA_PROJECT_ID=
VIRA_ENVIRONMENT_ID=
VIRA_BEHAVIOR_POINT=
VIRA_AI_SYSTEM_ID=
VIRA_CONNECTION_ID=

# Set VIRA_TUTORIAL_NON_PRODUCTION=true and VIRA_ALLOW_CONNECT=true only
# after verifying the target is isolated and authorizing connectOnce.
VIRA_TUTORIAL_NON_PRODUCTION=false
VIRA_ALLOW_CONNECT=false
VIRA_CONNECT_IDEMPOTENCY_KEY=
VIRA_SYSTEM_NAME=support-chatbot-example
