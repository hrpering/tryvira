VIRA_API_URL=https://api.example.invalid
VIRA_API_KEY=replace-me
VIRA_ORGANIZATION_ID=example-org
VIRA_PROJECT_ID=marketing-demo
VIRA_ENVIRONMENT_ID=example-environment
# Optional: allow plain HTTP only for localhost / 127.0.0.1 mock development.
VIRA_ALLOW_INSECURE_LOCALHOST=false
# Set this from the persisted Behavior Point after the authoring step.
# VIRA_CONTROL_POINT_ID=replace-after-authoring
VIRA_AI_SYSTEM_ID=replace-after-connect
VIRA_CONNECTION_ID=replace-after-connect
# Set these only for the separately reviewed Teach proposal operation.
VIRA_TUTORIAL_TEACH_PROPOSAL_ID=replace-after-proposal
VIRA_TUTORIAL_APPROVE_TEACH_PROPOSAL=false
VIRA_TUTORIAL_PROMOTE_TEACH_PROPOSAL=false
